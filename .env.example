# Variables que consume docker-compose.yml
# Copia este archivo como .env antes de levantar el proyecto.

# Contraseña de root de MySQL (la comparten los cuatro módulos)
DB_ROOT_PASSWORD=Tkd_Dev_2026!

# Secreto con el que tkd_pos firma las intenciones de cobro hacia tkd_pagos
PAGO_SECRET=tkd-dev-pago-secret

# Secreto con el que tkd_portal firma las redirecciones a tkd_pagos y tkd_pos
PORTAL_SECRET=tkd-dev-portal-secret

# Costo de la mensualidad que se cobra al renovar la suscripción
SUSCRIPCION_MONTO=500
